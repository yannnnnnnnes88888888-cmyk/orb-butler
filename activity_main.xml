<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部条：标题 + 设置开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_btn"
            android:minWidth="76dp"
            android:text="设置 ▴"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 权限卡：只有这里用的是原生按钮，所以「开通知」一定能点开系统设置 -->
    <LinearLayout
        android:id="@+id/cardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="权限状态"
            android:textColor="@color/text2"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="悬浮窗（显示在其他软件上方）"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="96dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn"
                android:text="去开启"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="系统通知（到点弹到通知栏）"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnNotify"
                android:layout_width="96dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn"
                android:text="去开启"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="精确闹钟（准点响，不被省电推迟）"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnExact"
                android:layout_width="96dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn"
                android:text="去开启"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="后台无忧（忽略电池优化）"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="96dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn"
                android:text="去设置"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOrb"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:text="启动光球"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/chkBoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="开机自启"
                android:textColor="@color/text2"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
